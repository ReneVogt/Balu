<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	  <TargetFramework>net10.0</TargetFramework>
	  <LangVersion>latest</LangVersion>
	  <Nullable>enable</Nullable>
	  <RootNamespace>Balu.Interactive</RootNamespace>
	  <EnableNETAnalyzers>true</EnableNETAnalyzers>
	  <AnalysisLevel>latest</AnalysisLevel>
	  <AnalysisMode>AllEnabledByDefault</AnalysisMode>
	  <AssemblyVersion>0.4.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
	  <ProjectReference Include="..\Balu\Balu.csproj" />
	  <ProjectReference Include="..\Balu.Interpretation\Balu.Interpretation.csproj" />
  </ItemGroup>

	<Target Name="CollectInterpreterReferenceAssemblies" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<_InterpreterReferenceAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'System.Runtime' OR '%(Filename)' == 'System.Runtime.Extensions' OR '%(Filename)' == 'System.Console'" />
		</ItemGroup>
	</Target>

	<Target Name="CopyInterpreterReferenceAssemblies"
			AfterTargets="CopyFilesToOutputDirectory"
			DependsOnTargets="CollectInterpreterReferenceAssemblies">
		<MakeDir Directories="$(TargetDir)reference-assemblies" />
		<Copy SourceFiles="@(_InterpreterReferenceAssembly)" DestinationFolder="$(TargetDir)reference-assemblies" SkipUnchangedFiles="true">
			<Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
		</Copy>
	</Target>

	<Target Name="PublishInterpreterReferenceAssemblies"
			BeforeTargets="ComputeResolvedFilesToPublishList"
			DependsOnTargets="CollectInterpreterReferenceAssemblies">
		<ItemGroup>
			<ResolvedFileToPublish Include="@(_InterpreterReferenceAssembly)">
				<RelativePath>reference-assemblies/%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
